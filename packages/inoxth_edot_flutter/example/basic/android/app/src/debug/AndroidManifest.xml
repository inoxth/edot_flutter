<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- This app exports to a collector on the developer's machine over plain HTTP,
         which Android has blocked by default since API 28. Debug-only on purpose:
         real deployments export over HTTPS, and relaxing the release manifest would
         hide a misconfigured server URL instead of failing on it.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28" />
</manifest>
