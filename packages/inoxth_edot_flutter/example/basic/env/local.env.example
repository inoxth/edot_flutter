# Copy this file to `.env` in this directory and point it at your collector.
# The app loads it at startup via flutter_dotenv; with no EDOT_SERVER_URL it shows
# a "Missing .env" screen instead of starting the Agent.

# OTLP endpoint the Agent exports to. Required.
# From an Android emulator reaching a collector on the host, use http://10.0.2.2:4318
EDOT_SERVER_URL=http://localhost:4318

# Identifies the app in Elastic. Optional - the defaults shown are used when unset.
EDOT_SERVICE_NAME=edot-flutter-example-basic
EDOT_SERVICE_VERSION=1.0.0
EDOT_DEPLOYMENT_ENVIRONMENT=example

# Elastic secret token. Leave blank for a local collector that needs no auth.
EDOT_SECRET_TOKEN=

# Fraction of sessions that report, 0.0-1.0. Defaults to 1.0 (all sessions).
# Honoured on Android; unreliable on iOS (see the plugin README).
EDOT_SESSION_SAMPLING_RATE=1.0

# OTLP transport: http (default) or grpc. grpc needs a collector configured for
# it - point EDOT_SERVER_URL at that receiver's port (usually 4317, not 4318).
EDOT_EXPORT_PROTOCOL=http
